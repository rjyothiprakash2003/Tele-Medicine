generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  ADMINISTRATOR
  SYSTEM_SERVICE
}

enum ConsultationMode {
  CHAT
  VIDEO
  ASSESSMENT
}

enum ConsultationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EMERGENCY_STOPPED
  ERROR
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum AvatarGender {
  MALE
  FEMALE
}

enum SafetySeverity {
  INFO
  WARNING
  HIGH
  EMERGENCY
}

enum DocumentType {
  PRIOR_PRESCRIPTION
  LAB_REPORT
  OTHER_MEDICAL
  AI_GENERATED_PRESCRIPTION_RECORD
  CONSULTATION_REPORT_PDF
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  SAFETY
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  role         UserRole @default(PATIENT)
  sessionToken String   @unique @map("session_token")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  patientProfile PatientProfile?
  appointments   Appointment[]
  consultations  Consultation[]
  documents      MedicalDocument[]
  notifications  Notification[]
  safetyEvents   SafetyEvent[]
  auditLogs      AdminAuditLog[]

  @@map("users")
}

model PatientProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  displayName            String?   @map("display_name")
  preferredLanguage      String    @default("en") @map("preferred_language")
  timezone               String    @default("Asia/Kolkata")
  dateOfBirth            DateTime? @map("date_of_birth")
  country                String?
  region                 String?
  heightCm               Float?    @map("height_cm")
  weightKg               Float?    @map("weight_kg")
  emergencyContactName   String?   @map("emergency_contact_name")
  emergencyContactPhone  String?   @map("emergency_contact_phone")
  consentAiDisclosure    Boolean   @default(false) @map("consent_ai_disclosure")
  consentTerms           Boolean   @default(false) @map("consent_terms")
  consentPrivacy         Boolean   @default(false) @map("consent_privacy")
  privacyPrefs           Json?     @map("privacy_prefs")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalProfile  MedicalProfile?
  consents        PatientConsent[]

  @@map("patient_profiles")
}

model PatientConsent {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  type      String
  version   String
  accepted  Boolean
  ipHint    String?  @map("ip_hint")
  createdAt DateTime @default(now()) @map("created_at")

  profile PatientProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("patient_consents")
}

model MedicalProfile {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @unique @map("profile_id") @db.Uuid
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile     PatientProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  conditions  MedicalCondition[]
  allergies   PatientAllergy[]
  medications PatientMedication[]

  @@map("medical_profiles")
}

model MedicalCondition {
  id               String   @id @default(uuid()) @db.Uuid
  medicalProfileId String   @map("medical_profile_id") @db.Uuid
  name             String
  status           String   @default("reported")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  medicalProfile MedicalProfile @relation(fields: [medicalProfileId], references: [id], onDelete: Cascade)

  @@index([medicalProfileId])
  @@map("medical_conditions")
}

model PatientAllergy {
  id               String   @id @default(uuid()) @db.Uuid
  medicalProfileId String   @map("medical_profile_id") @db.Uuid
  name             String
  severity         String?
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  medicalProfile MedicalProfile @relation(fields: [medicalProfileId], references: [id], onDelete: Cascade)

  @@index([medicalProfileId])
  @@map("patient_allergies")
}

model PatientMedication {
  id               String   @id @default(uuid()) @db.Uuid
  medicalProfileId String   @map("medical_profile_id") @db.Uuid
  name             String
  dosage           String?
  frequency        String?
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  medicalProfile MedicalProfile @relation(fields: [medicalProfileId], references: [id], onDelete: Cascade)

  @@index([medicalProfileId])
  @@map("patient_medications")
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  mode            ConsultationMode
  status          AppointmentStatus @default(SCHEDULED)
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @default(20) @map("duration_minutes")
  timezone        String            @default("Asia/Kolkata")
  avatarGender    AvatarGender?     @map("avatar_gender")
  language        String            @default("en")
  reason          String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations Consultation[]

  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("appointments")
}

model TokenCounter {
  id        String   @id @default("default")
  dateKey   String   @unique @map("date_key")
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("token_counters")
}

model Consultation {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  appointmentId      String?            @map("appointment_id") @db.Uuid
  tokenNumber        String             @unique @map("token_number")
  mode               ConsultationMode
  status             ConsultationStatus @default(ACTIVE)
  avatarGender       AvatarGender?      @map("avatar_gender")
  language           String             @default("en")
  reason             String?
  useMedicalProfile  Boolean            @default(false) @map("use_medical_profile")
  consentState       Json?              @map("consent_state")
  safetyOutcome      String?            @map("safety_outcome")
  conversationState  String             @default("READY") @map("conversation_state")
  startedAt          DateTime           @default(now()) @map("started_at")
  endedAt            DateTime?          @map("ended_at")
  thankYouShown      Boolean            @default(false) @map("thank_you_shown")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment   Appointment?           @relation(fields: [appointmentId], references: [id])
  messages      ConsultationMessage[]
  transcript    ConsultationTranscript?
  summary       ConsultationSummary?
  assessment    AssessmentResult?
  documents     MedicalDocument[]
  treatments    TreatmentRecommendation[]
  prescriptions PrescriptionDocument[]
  safetyEvents  SafetyEvent[]
  reports       MedicalReport[]

  @@index([userId, createdAt])
  @@index([tokenNumber])
  @@map("consultations")
}

model ConsultationMessage {
  id             String      @id @default(uuid()) @db.Uuid
  consultationId String      @map("consultation_id") @db.Uuid
  role           MessageRole
  content        String
  requestId      String?     @map("request_id")
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, createdAt])
  @@map("consultation_messages")
}

model ConsultationTranscript {
  id             String   @id @default(uuid()) @db.Uuid
  consultationId String   @unique @map("consultation_id") @db.Uuid
  content        String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_transcripts")
}

model ConsultationSummary {
  id             String   @id @default(uuid()) @db.Uuid
  consultationId String   @unique @map("consultation_id") @db.Uuid
  mainConcern    String?  @map("main_concern")
  summaryText    String   @map("summary_text")
  structured     Json?
  disclaimer     String
  createdAt      DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_summaries")
}

model MedicalSource {
  id                String   @id @default(uuid()) @db.Uuid
  title             String
  publisher         String
  url               String
  publishedAt       DateTime? @map("published_at")
  retrievedAt       DateTime  @default(now()) @map("retrieved_at")
  excerpt           String
  sourceType        String    @map("source_type")
  createdAt         DateTime  @default(now()) @map("created_at")

  assessmentLinks AssessmentSourceLink[]

  @@map("medical_sources")
}

model AssessmentResult {
  id                    String   @id @default(uuid()) @db.Uuid
  consultationId        String   @unique @map("consultation_id") @db.Uuid
  reportedFacts         Json     @map("reported_facts")
  extractedFromRecords  Json?    @map("extracted_from_records")
  aiInterpretations     Json     @map("ai_interpretations")
  unknowns              Json?
  possibleExplanations  Json?    @map("possible_explanations")
  uncertainties         String?
  nextSteps             String?  @map("next_steps")
  emergencyTriggered    Boolean  @default(false) @map("emergency_triggered")
  createdAt             DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sources      AssessmentSourceLink[]

  @@map("assessment_results")
}

model AssessmentSourceLink {
  id           String @id @default(uuid()) @db.Uuid
  assessmentId String @map("assessment_id") @db.Uuid
  sourceId     String @map("source_id") @db.Uuid

  assessment AssessmentResult @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  source     MedicalSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, sourceId])
  @@map("assessment_source_links")
}

model MedicalDocument {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  consultationId String?      @map("consultation_id") @db.Uuid
  type           DocumentType
  fileName       String       @map("file_name")
  mimeType       String       @map("mime_type")
  sizeBytes      Int          @map("size_bytes")
  storageKey     String       @map("storage_key")
  checksum       String?
  extractedText  String?      @map("extracted_text")
  status         String       @default("ready")
  createdAt      DateTime     @default(now()) @map("created_at")
  deletedAt      DateTime?    @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id])

  @@index([userId])
  @@map("medical_documents")
}

model TreatmentRecommendation {
  id             String   @id @default(uuid()) @db.Uuid
  consultationId String   @map("consultation_id") @db.Uuid
  title          String
  content        String
  isEducational  Boolean  @default(true) @map("is_educational")
  disclaimer     String
  createdAt      DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("treatment_recommendations")
}

model MedicationInformation {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  genericName      String?  @map("generic_name")
  summary          String
  sideEffects      String?  @map("side_effects")
  contraindications String? @map("contraindications")
  interactionsNote String?  @map("interactions_note")
  sourceLabel      String   @map("source_label")
  sourceUrl        String?  @map("source_url")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([name])
  @@map("medication_information")
}

model PrescriptionDocument {
  id                   String   @id @default(uuid()) @db.Uuid
  consultationId       String   @map("consultation_id") @db.Uuid
  storageKey           String   @map("storage_key")
  mimeType             String   @default("image/png") @map("mime_type")
  isLegallyValid       Boolean  @default(false) @map("is_legally_valid")
  legalDisclaimer      String   @map("legal_disclaimer")
  basedOnPriorDocs     Boolean  @default(false) @map("based_on_prior_docs")
  structuredContent    Json     @map("structured_content")
  createdAt            DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("prescription_documents")
}

model MedicalReport {
  id             String   @id @default(uuid()) @db.Uuid
  consultationId String   @map("consultation_id") @db.Uuid
  title          String
  contentJson    Json     @map("content_json")
  pdfStorageKey  String?  @map("pdf_storage_key")
  disclaimer     String
  createdAt      DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("medical_reports")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  body      String
  type      String
  readAt    DateTime? @map("read_at")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @unique @map("user_id") @db.Uuid
  inAppEnabled     Boolean @default(true) @map("in_app_enabled")
  remindersEnabled Boolean @default(true) @map("reminders_enabled")
  securityEnabled  Boolean @default(true) @map("security_enabled")

  @@map("notification_preferences")
}

model SafetyEvent {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  consultationId String?        @map("consultation_id") @db.Uuid
  severity       SafetySeverity
  ruleId         String         @map("rule_id")
  message        String
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id])

  @@index([severity, createdAt])
  @@map("safety_events")
}

model AiProviderConfig {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  provider  String
  isActive  Boolean  @default(false) @map("is_active")
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_provider_configs")
}

model AvatarConfig {
  id        String       @id @default(uuid()) @db.Uuid
  gender    AvatarGender
  label     String
  voiceId   String?      @map("voice_id")
  isActive  Boolean      @default(true) @map("is_active")
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("avatar_configs")
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@map("admin_audit_logs")
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  severity  String
  message   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("security_events")
}

model IdempotencyRecord {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  response  Json?
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("idempotency_records")
}
