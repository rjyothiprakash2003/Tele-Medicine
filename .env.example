# TELEMEDICINE AI — environment template (no secrets)
# Copy to apps/api/.env and apps/web/.env.local as needed.

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL) ---
# Local Docker: postgresql://telemedicine:telemedicine@localhost:5432/telemedicine?schema=public
DATABASE_URL=postgresql://telemedicine:telemedicine@localhost:5432/telemedicine?schema=public

# --- Redis (optional; in-memory fallback when unset) ---
REDIS_URL=

# --- Session ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=tmai_session
ADMIN_API_KEY=change-me-admin-key

# --- Feature flags ---
AI_PROVIDER=mock
AVATAR_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
STORAGE_PROVIDER=local
ENABLE_EMAIL=false

# --- Optional OpenAI-compatible medical AI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Optional real avatar / voice (leave empty for mock) ---
AVATAR_API_KEY=
AVATAR_API_URL=
TTS_API_KEY=
STT_API_KEY=

# --- Storage ---
LOCAL_STORAGE_PATH=./storage
AWS_REGION=ap-south-1
S3_BUCKET=
S3_DOCUMENTS_PREFIX=documents/

# --- Emergency guidance (India default) ---
EMERGENCY_NUMBER=112
EMERGENCY_AMBULANCE=108
EMERGENCY_REGION=IN

# --- Next.js public ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=TELEMEDICINE AI
NEXT_PUBLIC_EMERGENCY_NUMBER=112
